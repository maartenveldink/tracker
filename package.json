{
  "name": "tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"if(+process.versions.node.split('.')[0]<20){console.error('\\n[tracker] Node '+process.versions.node+' gevonden, maar dit project vereist Node >=20 (zie .nvmrc: 22). Draai eerst: nvm use\\n');process.exit(1)}\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
