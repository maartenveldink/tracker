# Tracker backend configuration. Copy to `.env` and fill in.

# Random 32-char key PocketBase uses to encrypt settings at rest.
# Generate e.g. with: openssl rand -hex 16
PB_ENCRYPTION_KEY=change-me-32-characters-long-xxxx

# First admin (superuser). Used once to bootstrap; created by deploy.sh.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-strong-password

# Public domain served by Caddy (automatic HTTPS via Let's Encrypt).
# Point its DNS A/AAAA record at this VPS and open ports 80 + 443 first.
# For local testing without a domain, use: TRACKER_DOMAIN=localhost
TRACKER_DOMAIN=tracker.example.com

# Optional: Let's Encrypt account e-mail (for cert-expiry notices). Leave empty
# to skip. Ignored when TRACKER_DOMAIN=localhost (self-signed cert).
TRACKER_TLS_EMAIL=
