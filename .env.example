# Frontend configuration (build-time, Vite). Copy to `.env` and adjust.

# Base URL of the self-hosted PocketBase backend (see server/README.md).
# Leave unset to use the same origin the PWA is served from.
VITE_PB_URL=http://localhost:8090

# Set to "true" to show the "Inloggen met Google" button (requires the Google
# OAuth2 provider to be configured in the PocketBase admin UI). Username/password
# login always works and needs no SMTP.
VITE_ENABLE_GOOGLE_LOGIN=false
